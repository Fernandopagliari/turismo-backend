import qrcode
import os

def generar_qr_backend():
    # URL de tu backend
    url = "https://turismo-backend-av60.onrender.com"
    
    # Configurar QR
    qr = qrcode.QRCode(
        version=1,
        error_correction=qrcode.constants.ERROR_CORRECT_L,
        box_size=10,
        border=4,
    )
    
    # Agregar datos
    qr.add_data(url)
    qr.make(fit=True)
    
    # Crear imagen
    img = qr.make_image(fill_color="black", back_color="white")
    
    # Guardar
    img.save("qr_backend.png")
    print("✅ QR generado: qr_backend.png")
    
    # Mostrar en consola (opcional)
    print(f"🔗 URL: {url}")

# Ejecutar
if __name__ == "__main__":
    generar_qr_backend()